{
    "name": "calculators",
    "version": "2.0.0",
    "private": true,
    "main": "app.js",
    "scripts": {
        "start": "node app.js",
        "dev": "node --watch --env-file-if-exists=.env app.js",
        "build": "webpack --mode production",
        "build_dev": "webpack --mode development --watch",
        "pretest": "webpack --mode production",
        "test": "node --test \"test/**/*.test.*\"",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run lint && npm run format:check && npm test"
    },
    "engines": {
        "node": ">=24"
    },
    "author": "seraphim",
    "license": "ISC",
    "description": "Fun everyday calculators: eggs, working days, egg timer, age, countdown, pizza and bill splitting",
    "dependencies": {
        "compression": "^1.8.2",
        "ejs": "^7.0.2",
        "express": "^5.3.0",
        "express-ejs-layouts": "^2.5.1",
        "helmet": "^8.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "prettier": "^3.10.1",
        "webpack": "^5.113.0",
        "webpack-cli": "^7.3.1"
    }
}
