<section class="card">
    <h1><%= t("pages.pizza.heading") %></h1>
    <form id="calc" class="calc">
        <div class="pizza-grid">
            <% [1, 2, 3, 4].forEach((n) => { %>
            <fieldset class="pizza">
                <legend><%= t("pages.pizza.pizza", { n }) %></legend>
                <div class="field">
                    <label for="d<%= n %>"><%= t("pages.pizza.diameter") %></label>
                    <input type="number" id="d<%= n %>" name="d<%= n %>" min="1" max="200" step="any" inputmode="decimal"<% if (n <= 2) { %> required<% } %> />
                </div>
                <div class="field">
                    <label for="p<%= n %>"><%= t("pages.pizza.price") %></label>
                    <input type="number" id="p<%= n %>" name="p<%= n %>" min="0" max="10000" step="0.01" inputmode="decimal"<% if (n <= 2) { %> required<% } %> />
                </div>
                <div class="field">
                    <label for="q<%= n %>"><%= t("pages.pizza.quantity") %></label>
                    <input type="number" id="q<%= n %>" name="q<%= n %>" min="1" max="50" step="1" value="1" inputmode="numeric" />
                </div>
            </fieldset>
            <% }) %>
        </div>
        <button type="submit" class="btn"><%= t("common.calculate") %></button>
    </form>
    <%- include("partials/result") %>
</section>
