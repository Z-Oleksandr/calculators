<section class="card">
    <h1><%= t("pages.split.heading") %></h1>
    <form id="calc" class="calc">
        <div class="field-row">
            <div class="field">
                <label for="amount"><%= t("pages.split.amount") %></label>
                <input type="number" id="amount" name="amount" min="0.01" max="10000000" step="0.01" required inputmode="decimal" />
            </div>
            <div class="field">
                <label for="tip"><%= t("pages.split.tip") %></label>
                <input type="number" id="tip" name="tip" min="0" max="100" step="any" value="10" required inputmode="decimal" />
            </div>
            <div class="field">
                <label for="people"><%= t("pages.split.people") %></label>
                <input type="number" id="people" name="people" min="1" max="1000" step="1" value="2" required inputmode="numeric" />
            </div>
        </div>
        <label class="check">
            <input type="checkbox" name="round" value="1" />
            <span><%= t("pages.split.roundUp") %></span>
        </label>
        <button type="submit" class="btn"><%= t("common.calculate") %></button>
    </form>
    <%- include("partials/result") %>
</section>
