<header class="header">
    <a href="<%= nav[0].href %>" class="logo"><%= t("meta.siteName") %></a>
    <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
    >
        <%= t("nav.menu") %>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="<%= t("nav.main") %>">
        <ul>
            <% nav.forEach((item) => { %>
            <li>
                <a href="<%= item.href %>"<% if (item.key === page) { %> aria-current="page"<% } %>><%= item.label %></a>
            </li>
            <% }) %>
        </ul>
    </nav>
    <div class="header-tools">
        <nav class="languages" aria-label="<%= t("nav.language") %>">
            <% alternates.forEach((alt) => { %>
            <a
                href="<%= alt.href %>"
                hreflang="<%= alt.locale %>"
                lang="<%= alt.locale %>"
                title="<%= alt.name %>"
                data-lang-link
                <% if (alt.locale === locale) { %>aria-current="true"<% } %>
            ><%= alt.locale.toUpperCase() %></a>
            <% }) %>
        </nav>
        <button
            type="button"
            class="theme-toggle"
            aria-label="<%= t("nav.theme") %>"
            title="<%= t("nav.theme") %>"
        >
            <span aria-hidden="true">◐</span>
        </button>
    </div>
</header>
