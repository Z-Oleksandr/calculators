<section class="card prose">
    <h1><%= t("pages.about.heading") %></h1>
    <p><%= t("pages.about.intro") %></p>
    <ul class="link-list">
        <% nav.filter((item) => item.key !== "about").forEach((item) => { %>
        <li><a href="<%= item.href %>"><%= item.label %></a></li>
        <% }) %>
    </ul>
    <p><%= t("pages.about.privacy") %></p>
    <p>
        <%= t("pages.about.blog") %>
        <a href="https://theblog.sbmedia.dev" rel="noopener">theBlog</a>
    </p>
</section>
