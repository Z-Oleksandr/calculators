<section class="card">
    <h1><%= t("pages.work.heading") %></h1>
    <form id="calc" class="calc">
        <%- include("partials/period") %>
        <fieldset class="weekdays">
            <legend><%= t("pages.work.workdays") %></legend>
            <% weekdays.forEach((day) => { %>
            <label class="check">
                <input type="checkbox" name="d" value="<%= day.index %>"<% if (day.index >= 1 && day.index <= 5) { %> checked<% } %> />
                <span><%= day.name %></span>
            </label>
            <% }) %>
        </fieldset>
        <div class="field-row">
            <div class="field">
                <label for="hours"><%= t("pages.work.hours") %></label>
                <input type="number" id="hours" name="hours" min="0" max="24" step="0.25" value="8" required inputmode="decimal" />
            </div>
            <div class="field">
                <label for="vacation"><%= t("pages.work.vacation") %></label>
                <input type="number" id="vacation" name="vacation" min="0" max="10000" step="0.5" value="0" inputmode="decimal" />
            </div>
            <div class="field">
                <label for="sick"><%= t("pages.work.sick") %></label>
                <input type="number" id="sick" name="sick" min="0" max="10000" step="0.5" value="0" inputmode="decimal" />
            </div>
        </div>
        <%- include("partials/holidays") %>
        <div class="field-row">
            <div class="field">
                <label for="eggs"><%= t("common.eggsPerDay") %> <%- include("partials/optional") %></label>
                <input type="number" id="eggs" name="eggs" min="0" max="100" step="any" inputmode="decimal" />
            </div>
            <div class="field">
                <label for="rate"><%= t("pages.work.rate") %> <%- include("partials/optional") %></label>
                <input type="number" id="rate" name="rate" min="0" max="100000" step="0.01" inputmode="decimal" />
            </div>
        </div>
        <button type="submit" class="btn"><%= t("common.calculate") %></button>
    </form>
    <%- include("partials/result") %>
</section>
