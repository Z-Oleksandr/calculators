<section class="card">
    <h1><%= t("pages.eggs.heading") %></h1>
    <form id="calc" class="calc">
        <%- include("partials/period") %>
        <div class="field-row">
            <div class="field">
                <label for="eggs"><%= t("common.eggsPerDay") %></label>
                <input type="number" id="eggs" name="eggs" min="0" max="100" step="any" value="1" required inputmode="decimal" />
            </div>
            <div class="field">
                <label for="price"><%= t("pages.eggs.price") %> <%- include("partials/optional") %></label>
                <input type="number" id="price" name="price" min="0" max="1000" step="0.01" inputmode="decimal" />
            </div>
            <div class="field">
                <label for="age"><%= t("pages.eggs.age") %> <%- include("partials/optional") %></label>
                <input type="number" id="age" name="age" min="0" max="130" step="1" inputmode="numeric" />
            </div>
        </div>
        <button type="submit" class="btn"><%= t("common.calculate") %></button>
    </form>
    <%- include("partials/result") %>
</section>
